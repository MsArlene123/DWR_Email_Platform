generator client {
    provider = "prisma-client-js"
    // "native" covers whatever machine runs the build;
    // "debian-openssl-3.0.x" covers Ubuntu servers such as the
    // DigitalOcean droplet when the build happens elsewhere (GitHub).
    // The previous config hardcoded an output path that only existed
    // on the Abacus server, which broke builds everywhere else.
    binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// NextAuth Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// User roles for access control.
// ADMIN  - can see and manage ALL users' data (templates, campaigns,
//          contacts, etc.), plus manage user accounts (create, delete,
//          reset password, change role).
// USER   - can only see and manage their own data.
enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  emailAccounts  EmailAccount[]
  googleSheets   GoogleSheet[]
  templates      EmailTemplate[]
  campaigns      Campaign[]
  dripSequences  DripSequence[]
  images         UploadedImage[]
  bouncedEmails  BouncedEmail[]
  unsubscribes   Unsubscribe[]
  contacts       Contact[]

  @@index([email])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// Email Account Management
// CHANGED: Added GENERIC_SMTP to enum (Item 2)
// CHANGED: Added businessName, businessAddress, businessPhone (Item 1)
// ============================================================
enum EmailAccountType {
  GMAIL
  TITAN_SMTP
  ZOHO_SMTP
  GENERIC_SMTP
}

model EmailAccount {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          EmailAccountType
  email         String
  displayName   String?
  
  // Business identity for CAN-SPAM footer (Item 1)
  businessName    String?
  businessAddress String?
  businessPhone   String?
  
  // For Gmail OAuth
  accessToken   String?          @db.Text
  refreshToken  String?          @db.Text
  tokenExpiry   DateTime?
  
  // For SMTP (Titan, Zoho, Generic, etc.)
  smtpHost      String?
  smtpPort      Int?
  smtpPassword  String?          @db.Text
  
  isActive      Boolean          @default(true)
  dailyLimit    Int              @default(500)
  emailsSentToday Int            @default(0)
  lastResetDate DateTime         @default(now())
  lastSentAt    DateTime?        // for per-account burst limiting

  // Cached DNS authentication score (DKIM/SPF/DMARC)
  // Refreshed daily by a cron, or on-demand from the dashboard.
  // 'good' = all 3 pass, 'partial' = some pass, 'poor' = none pass
  domainAuthScore    String?     // 'good' | 'partial' | 'poor'
  domainAuthDetail   String?     @db.Text  // JSON: {spf, dkim, dmarc, mx, recommendations}
  domainAuthCheckedAt DateTime?

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  campaigns      Campaign[]
  dripSequences  DripSequence[]
  emailLogs      EmailLog[]

  @@index([userId])
  @@index([email])
}

// Google Sheets Integration
model GoogleSheet {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  sheetUrl        String
  sheetId         String
  
  // OAuth tokens for accessing Google Sheets
  accessToken     String?    @db.Text
  refreshToken    String?    @db.Text
  tokenExpiry     DateTime?
  
  // Column mapping
  columns         String     @db.Text // JSON string of detected columns
  recipientCount  Int        @default(0)

  // List splitting: when a list is split into N sub-lists, each sub-list
  // has parentSheetId set to the original sheet's ID. The original sheet
  // has parentSheetId = null. Sub-lists store their contacts in the
  // Contact table (not in a real Google Sheet) — campaign creation
  // detects this and reads from Contact instead of parsing the URL.
  parentSheetId   String?    // null = original sheet, set = sub-list
  splitIndex      Int?       // 1-based index (e.g., 1 of 4)
  splitTotal      Int?       // total number of sub-lists (e.g., 4)
  
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  campaigns       Campaign[]
  dripSequences   DripSequence[]

  @@index([userId])
  @@index([sheetId])
  @@index([parentSheetId])
}

// Email Templates
enum TemplateCategory {
  NONPROFIT
  ATTORNEY_LEGAL
  BOOKSTORE_MEDIA
  GENERAL_BUSINESS
  CUSTOM
  PRESS_MEDIA
  LAWYERS
  WOMEN_OWNED_BUSINESS
  SHELTER_HOUSING
  CHILDCARE
  HEALTHCARE_CLINIC
  SPIRITUAL_HEALING
  WOMEN_MONEY
  SUPPORTIVE_GROWTH_COUNSELORS
  LEGAL_RESOURCES
  EMPLOYMENT
  EDUCATION
  AFFILIATES
  LEGAL_AID
  CREDIT_COUNSELING
  HUD_COUNSELORS
}

model EmailTemplate {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  category       String
  subject        String
  htmlContent    String           @db.Text
  plainText      String?          @db.Text
  isSample       Boolean          @default(false)
  
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  campaigns      Campaign[]
  dripSteps      DripSequenceStep[]

  @@index([userId])
  @@index([category])
}

// Campaign Management
enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  STOPPED
  FAILED
}

model Campaign {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  status            CampaignStatus @default(DRAFT)
  
  emailAccountId    String
  emailAccount      EmailAccount   @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  
  googleSheetId     String
  googleSheet       GoogleSheet    @relation(fields: [googleSheetId], references: [id], onDelete: Cascade)
  
  templateId        String
  template          EmailTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  subject           String
  sendingRate       Int            @default(3) // minutes between emails
  scheduledStart    DateTime?
  actualStart       DateTime?
  completedAt       DateTime?
  
  totalRecipients   Int            @default(0)
  emailsSent        Int            @default(0)
  emailsFailed      Int            @default(0)
  
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  emailLogs         EmailLog[]

  @@index([userId])
  @@index([status])
  @@index([emailAccountId])
}

// ============================================================
// Drip Campaign (Email Sequences)
// CHANGED: googleSheetId now has proper relation to GoogleSheet (Item 6)
// ============================================================
model DripSequence {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  
  emailAccountId  String?
  emailAccount    EmailAccount?      @relation(fields: [emailAccountId], references: [id], onDelete: SetNull)
  
  // CHANGED: Proper relation to GoogleSheet for auto-enrollment (Item 6)
  googleSheetId   String?
  googleSheet     GoogleSheet?       @relation(fields: [googleSheetId], references: [id], onDelete: SetNull)
  
  isActive                Boolean            @default(false)
  sendingIntervalMinutes  Int                @default(5)
  
  // Track enrollment state
  lastEnrollmentSync  DateTime?
  
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  steps           DripSequenceStep[]
  progress        RecipientProgress[]

  @@index([userId])
  @@index([emailAccountId])
  @@index([googleSheetId])
}

model DripSequenceStep {
  id              String         @id @default(cuid())
  dripSequenceId  String
  dripSequence    DripSequence   @relation(fields: [dripSequenceId], references: [id], onDelete: Cascade)
  
  stepOrder       Int            // 1, 2, 3, etc.
  templateId      String
  template        EmailTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  subject         String
  delayDays       Int            @default(0)
  delayHours      Int            @default(0)
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([dripSequenceId])
  @@index([stepOrder])
}

// Recipient Progress in Drip Campaign
model RecipientProgress {
  id              String        @id @default(cuid())
  dripSequenceId  String
  dripSequence    DripSequence  @relation(fields: [dripSequenceId], references: [id], onDelete: Cascade)
  
  recipientEmail  String
  currentStep     Int           @default(0)
  completed       Boolean       @default(false)
  
  // Store personalization data so we do not re-fetch the sheet on every step
  personalizationData String?   @db.Text
  
  lastEmailSent   DateTime?
  nextEmailDue    DateTime?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([dripSequenceId, recipientEmail])
  @@index([dripSequenceId])
  @@index([recipientEmail])
  @@index([nextEmailDue])
}

// Uploaded Images (Image Library)
model UploadedImage {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName          String
  cloud_storage_path String
  isPublic          Boolean  @default(true)
  publicUrl         String?  @db.Text
  contentType       String   @default("image/png")
  fileSize          Int?     // bytes
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

// Email Sending Logs
enum EmailStatus {
  PENDING
  SENT
  FAILED
  RETRY
  BOUNCED
  OPENED
}

model EmailLog {
  id              String       @id @default(cuid())
  campaignId      String?
  campaign        Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  emailAccountId  String
  emailAccount    EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  
  recipientEmail  String
  recipientName   String?
  subject         String
  
  status          EmailStatus  @default(PENDING)
  error           String?      @db.Text
  retryCount      Int          @default(0)
  
  trackingId      String?
  openedAt        DateTime?
  openCount       Int          @default(0)
  clickCount      Int          @default(0)
  lastClickedAt   DateTime?
  personalizationData String?      @db.Text
  
  // Link to internal contact if exists (Item 7)
  contactId       String?
  
  sentAt          DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([campaignId])
  @@index([status])
  @@index([recipientEmail])
  @@index([sentAt])
  @@index([trackingId])
  @@index([contactId])
}

model Unsubscribe {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  createdAt DateTime @default(now())

  @@unique([userId, email])
  @@index([userId])
  @@index([email])
}

model BouncedEmail {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email           String
  bounceCount     Int      @default(1)
  lastBounceAt    DateTime @default(now())
  reason          String?  @db.Text
  isBlacklisted   Boolean  @default(false)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, email])
  @@index([userId])
  @@index([email])
}

// ============================================================
// Global Suppression List (CAN-SPAM compliance)
// ============================================================
// A single email address in this table will NEVER be sent to —
// by ANY user, ANY campaign, ANY drip sequence. This is the hard
// stop that prevents sending to:
//   - Spam traps (deliverability killers)
//   - Known complainers (people who hit "Mark as Spam")
//   - Hard bounces that should never be retried
//   - Manually suppressed addresses (admin-added)
//
// Checked by lib/suppression.ts → isGloballySuppressed(email)
// Called from both campaign-processor.ts and drip-processor.ts
// BEFORE any send attempt.
//
// Email is normalized: lowercase + trim (matches bounce-tracker.ts).
// ============================================================
enum SuppressionReason {
  SPAM_TRAP          // known spam-trap address
  COMPLAINT          // recipient hit "Mark as Spam"
  HARD_BOUNCE        // permanent delivery failure (550, mailbox not found)
  MANUAL             // admin manually added
  RECIPIENT_REQUEST  // recipient explicitly asked to never be emailed
}

model GlobalSuppression {
  id          String             @id @default(cuid())
  email       String             @unique  // normalized: lowercase + trim
  reason      SuppressionReason
  source      String?            // who/what added it (e.g., "bounce-tracker", "admin@docwritereview.com")
  notes       String?            @db.Text  // optional context
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([email])
  @@index([reason])
}

// ============================================================
// Internal Contacts Database (Item 7, Option B)
// Single source of truth for every person you email.
// Google Sheets are the import source. This table is the live data.
// ============================================================
enum ContactStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  BLACKLISTED
}

model Contact {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  email           String
  firstName       String?
  lastName        String?
  title           String?
  companyName     String?
  website         String?
  phone           String?
  
  status          ContactStatus @default(ACTIVE)
  
  // Segmentation: comma-separated tags (e.g., "WomenShield-Legal-Resource,Segment-B")
  tags            String?       @db.Text
  // Which list/category this contact belongs to
  listName        String?
  
  // Import tracking
  sourceSheetId   String?       // Which Google Sheet they came from
  sourceSheetName String?       // Human-readable sheet name
  importedAt      DateTime      @default(now())
  
  // Status timestamps
  unsubscribedAt  DateTime?
  lastBouncedAt   DateTime?
  
  // Engagement summary (updated after each send/open/click)
  totalEmailsSent   Int         @default(0)
  totalOpens        Int         @default(0)
  totalClicks       Int         @default(0)
  lastEmailSentAt   DateTime?
  lastOpenedAt      DateTime?
  lastClickedAt     DateTime?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@unique([userId, email])
  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([tags])
  @@index([listName])
  @@index([sourceSheetId])
}