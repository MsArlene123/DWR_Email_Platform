# Database connection (PostgreSQL)
DATABASE_URL=

# NextAuth session secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=

# App URL (e.g. https://mail.docwritereview.work)
NEXTAUTH_URL=

# Cron authentication secret (generate with: openssl rand -hex 32)
CRON_SECRET=

# SMTP password encryption key - MUST be exactly 64 hex characters
# Generate with: openssl rand -hex 32
# WARNING: If this key changes, all stored SMTP passwords must be re-entered
ENCRYPTION_KEY=

# ───────────────────────────────────────────────────────────────────
# File storage (AWS S3 OR DigitalOcean Spaces)
# ───────────────────────────────────────────────────────────────────
# Both providers use the same S3 API. For DigitalOcean Spaces:
#   1. Create a Space at https://cloud.digitalocean.com/spaces
#   2. Generate a Spaces access key pair at
#      https://cloud.digitalocean.com/spaces/settings (Settings → Spaces Keys)
#   3. Fill in the values below.

# Region. For AWS S3 use "us-east-1" etc. For DO Spaces use "nyc3", "sfo3",
# "fra1", "syd1", "sgp1", "ams3" — whatever region your Space lives in.
AWS_REGION=

# Bucket name (AWS S3) OR Space name (DigitalOcean Spaces).
# Just the name, no URL. e.g. "dwr-email-assets"
AWS_BUCKET_NAME=

# Optional prefix prepended to every object key. Useful for putting all
# uploads under a folder. Leave blank for no prefix. e.g. "prod/"
AWS_FOLDER_PREFIX=

# REQUIRED for DigitalOcean Spaces. Leave blank for native AWS S3.
# Examples:
#   https://nyc3.digitaloceanspaces.com
#   https://sfo3.digitaloceanspaces.com
#   https://fra1.digitaloceanspaces.com
AWS_ENDPOINT=

# Access key ID from AWS IAM (S3) OR DigitalOcean Spaces settings.
AWS_ACCESS_KEY_ID=

# Secret access key from AWS IAM (S3) OR DigitalOcean Spaces settings.
AWS_SECRET_ACCESS_KEY=
